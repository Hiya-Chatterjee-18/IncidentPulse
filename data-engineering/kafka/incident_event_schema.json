{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentLifecycleEvent",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "incident_id": { "type": "string" },
    "event_type": { 
      "type": "string",
      "enum": ["INCIDENT_CREATED", "STATUS_CHANGED", "SLA_BREACH", "INCIDENT_RESOLVED"]
    },
    "category": { "type": "string" },
    "priority": { "type": "string" },
    "reporter_dept": { "type": "string" },
    "response_time_min": { "type": "integer" },
    "resolution_time_min": { "type": "integer" },
    "sla_breached": { "type": "boolean" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "incident_id", "event_type", "category", "priority", "timestamp"]
}
